# ---------------------------------------------------------------------------
# CPSC 3640/5400 Course NFT — deployment environment
#
# Copy to `.env` and fill in. `.env` is git-ignored and MUST NEVER be committed.
# These values are used ONLY by Foundry (forge script) on your machine.
# They are NEVER read by Vite and NEVER shipped to the browser.
# ---------------------------------------------------------------------------

# JSON-RPC endpoint for Ethereum Sepolia.
# e.g. https://eth-sepolia.g.alchemy.com/v2/<key>  or  https://sepolia.infura.io/v3/<key>
SEPOLIA_RPC_URL=

# Private key of the deploying account, 0x-prefixed.
# Use a THROWAWAY key that holds only Sepolia test ETH. Never a real-funds key.
DEPLOYER_PRIVATE_KEY=

# Optional. Enables automatic source verification on Etherscan.
# Leave blank to skip verification.
ETHERSCAN_API_KEY=

# Optional. Defaults to "false": ANY address may claim one token. Set "true" to
# require a Merkle proof built from allowlist/addresses.json.
#
# One NFT per wallet holds either way, but with no allowlist one person can use
# several wallets, so an open claim is a collectible for whoever finds the page
# rather than a record of who was enrolled.
REQUIRE_ALLOWLIST=false
