# Secrets - never commit
.env
.env.local
.env.*.local

# Foundry build output and broadcast/cache artifacts.
# cache/ matters: forge writes the broadcasting key material there.
cache/
out/
broadcast/

# Node
node_modules/
web/node_modules/

# Frontend build output. Published to gh-pages, never tracked on main.
web/dist/

# Generated from allowlist/addresses.json by `npm run merkle`.
# allowlist/generated/example-tree.json IS committed - the Foundry tests read it.
allowlist/generated/root.json
allowlist/generated/proofs.json
web/public/proofs.json

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# NFT generator: derived assets and all generated output. Rebuild with
# `npm run prepare-assets`; the supplied sources and overlay SVGs are tracked.
generator/output/
generator/assets/base/
generator/assets/masks/
generator/assets/.prepared.json
generator/.env
# Card layers for the claim page, from `npm run export-web` in generator/.
web/public/nft/
